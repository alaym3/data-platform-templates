# no private info is in this file, so it can be committed to the repo as an example for users to copy and edit with their own values
PROJECT_NAME=mage_project
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
MB_DB_TYPE=postgres
MB_DB_DBNAME=metabase
MAGE_DATABASE_CONNECTION_URL="postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?options=-c%20search_path%3Dmage"